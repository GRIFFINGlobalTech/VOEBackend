        public bool checkLoanPermissionForUser(string LoanNumber, string UserName, string Password)
        {
            bool retVal = false;

            try
            {
                FHMC.EncompassREST.Authentication auth = new FHMC.EncompassREST.Authentication();
                string accessToken = auth.getAccessToken(UserName, Password);

                FHMC.EncompassREST.Loan loan = new FHMC.EncompassREST.Loan();
                string loanGUID = loan.getGUIDforLoanNumber(LoanNumber, accessToken);
                if (loanGUID != "")
                {
                    retVal = true;
                }
            }
            catch (FHMC.EncompassREST.CustomException.CustomEMUserLoanPermissionException pex)
            {
                pex.LoanNumber = LoanNumber;
                pex.UserName = UserName;
                Log.Error("Loan Permission Error", pex);
            }
            catch (Exception ex)
            {
                throw ex;
            }


            return retVal;

        }

        public string getLoanLock(string LoanGUID, string accessToken, string LoanNumber = "")
        {
            string retVal = null;

            try
            {

                string methodURL = EncRESTServiceBaseURL() + "resourceLocks?view=id";

                LoanLockRequest request = new LoanLockRequest();
                request.lockType = LoanLockRequest.LockType.exclusive;
                LoanLockRequest.Resource resource = new LoanLockRequest.Resource();
                resource.entityId = LoanGUID;
                resource.entityType = "loan";
                request.resource = resource;

                string requestString = JsonConvert.SerializeObject(request, Newtonsoft.Json.Formatting.None,
                        new JsonSerializerSettings
                        {
                            NullValueHandling = NullValueHandling.Ignore
                        });

                string responseString = makeServiceRequest(methodURL, WebRequestMethod.POST, requestString, accessToken);

                LoanLockResponse response = JsonConvert.DeserializeObject<LoanLockResponse>(responseString);

                retVal = response.id;

                Log.Info("Loan Locked: " + LoanNumber);



            }
            catch (Exception ex)
            {
                Log.Error("Error getting lock for loan " + LoanNumber, ex);
                throw ex;
            }

            return retVal;

        }

        public bool releaseLoanLock(string loanGUID, string lockId, string accessToken, string LoanNumber = "")
        {

            bool retVal = false;

            try
            {

                string methodURL = EncRESTServiceBaseURL() + "resourceLocks/" + lockId;

                Dictionary<string, string> urlParams = new Dictionary<string, string>() { };
                urlParams.Add("resourceType", "loan");
                urlParams.Add("resourceId", loanGUID);

                string responseString = makeServiceRequest(methodURL, WebRequestMethod.DELETE, null, accessToken, urlParams);

                retVal = true;

                Log.Info("Loan lock released: " + LoanNumber);



            }
            catch (Exception ex)
            {
                Log.Error("Error releasing loan lock for " + LoanNumber, ex);
                //throw ex;
            }

            return retVal;
        }

        public bool addConversationLogEmail(string LoanNumber, string LogSubject, string LogEmailBody, string accessToken)
        {
            bool retVal = false;

            try
            {

                //first, get the loan GUID
                string loanGUID = getGUIDforLoanNumber(LoanNumber, accessToken);

                string methodURL = EncRESTServiceBaseURL() + "loans/" + loanGUID + "/conversationlogs?action=add";

                ConversationLog log = new ConversationLog
                {
                    comments = LogEmailBody,
                    inLogIndicator = true,
                    isEmailIndicator = true,
                    name = LogSubject
                };

                List<ConversationLog> request = new List<ConversationLog>() { };
                request.Add(log);

                string requestString = JsonConvert.SerializeObject(request, Newtonsoft.Json.Formatting.None,
                            new JsonSerializerSettings
                            {
                                NullValueHandling = NullValueHandling.Ignore
                            });

                string responseString = makeServiceRequest(methodURL, WebRequestMethod.PATCH, requestString, accessToken, null);

                retVal = true;

                Log.Info("Conversation Log Added: " + LoanNumber);



            }
            catch (Exception ex)
            {
                Log.Error("Error adding conversation log " + LoanNumber, ex);
                throw ex;
            }

            return retVal;

        }

        public string createLoan(string accessToken, string loanFolderName, string firstName, string LastName, string borrowerSSN, DateTime? borrowerDOB, string homePhoneNumber, string emailAddress, 
            bool authorizedCreditReportIndicator, DateTime authorizedCreditReportDate, string creditReportAuthorizationMethod, string addressStreetLine1, string addressCity,
            string addressState, string addressPostalCode, string loanOfficerName, string loanOfficerEncompassId, string creditReportReferenceIdentifier, string referralSource, 
            bool prequalCreditReportIndicator, string equifaxScore, string transUnionScore, string experianScore)
        {
           
            string retVal = null;

            string methodURL = EncRESTServiceBaseURL().Replace("v1","v3") + "loans?loanFolder=" + loanFolderName + "&view=entity";

            Loan req = new Loan();

            Application app = new Application();
            Borrower borrower = new Borrower();
            borrower.firstName = firstName;
            borrower.lastName = LastName;
            if (borrowerDOB != null)
            {
                borrower.birthDate = borrowerDOB;
            }
            borrower.taxIdentificationIdentifier = borrowerSSN;
            borrower.homePhoneNumber = homePhoneNumber;
            borrower.emailAddressText = emailAddress;
            borrower.authorizedCreditReportIndicator = authorizedCreditReportIndicator;
            borrower.authorizedCreditReportDate = authorizedCreditReportDate.ToString("yyyy-MM-dd");
            borrower.creditReportAuthorizationMethod = "Internet";

            borrower.experianCreditScore = experianScore;
            borrower.equifaxScore = equifaxScore;
            borrower.transUnionScore = transUnionScore;

            Residence residence = new Residence();
            residence.residencyType = "Current";
            residence.addressCity = addressCity;
            residence.addressPostalCode = addressPostalCode;
            residence.addressState = addressState;
            residence.addressStreetLine1 = addressStreetLine1;

            borrower.residences = new List<Residence>() { };
            borrower.residences.Add(residence);

            app.borrower = borrower;
            app.loanOfficerName = loanOfficerName;
            app.creditReportReferenceIdentifier = creditReportReferenceIdentifier;
            app.prequalCreditReportIndicator = prequalCreditReportIndicator;

            req.applications = new List<Application>() { };
            req.applications.Add(app);

            req.ReferralSource = referralSource;


            string requestString = JsonConvert.SerializeObject(req);

            string loanEntityString = makeServiceRequest(methodURL, WebRequestMethod.POST, requestString, accessToken);

            Loan resp = JsonConvert.DeserializeObject<Loan>(loanEntityString);

            string loanNumber = resp.loanNumber;

            string orgId = string.Empty;

            //get "file started" milestone
            LoanMilestones oMilestone = new LoanMilestones();
            List<LoanMilestones.LoanMilestone> loanMilestones = oMilestone.getLoanMilestones(resp.id, accessToken);
            LoanMilestones.LoanMilestone loanMilestone = loanMilestones.Where(q => q.milestoneIdstring == "2").FirstOrDefault();

            LoanAssociates oAssociate = new LoanAssociates();
            if(!oAssociate.assignLoanAssociate(resp.id, accessToken, loanOfficerEncompassId, loanMilestone.id))
            {
                throw new Exception("Error Assigning LO to Loan for LoanNumber " + loanNumber);
            }

            //update loannumber
            List<string> fields = new List<string>() {};
            fields.Add("ORGID");
            Dictionary<string, object> fieldResults = getLoanFields(loanNumber, fields, accessToken);

            orgId = fieldResults.Where(q => q.Key == "ORGID").FirstOrDefault().Value.ToString();

            if (updateField(loanNumber, "loanNumber", orgId + loanNumber, accessToken))
            {
                retVal = orgId + loanNumber;
            }
            else
            {
                throw new Exception("Error Updating LoanNumber " + loanNumber);
            }


            return retVal;


        }

        public bool updateField(string LoanNumber, string fieldName, string newFieldValue, string accessToken)
        {
            bool retVal = false;
            string lockId = null;
            string loanGUID = null;

            try
            {
                //must see if there are still docs in teh loan folder queue that could be importing
                string[] loanDocuments = Directory.GetFiles(LoanFolderImportLocation, LoanNumber + "*");

                if (loanDocuments.Length != 0)
                {
                    //there are documents waiting to upload...so we should not try to updateloan until that is complete
                    Log.Info("Documents Waiting to Upload for " + LoanNumber + ". Loan Update Skipped.");

                }
                else
                {

                    //first, get the loan GUID
                    loanGUID = getGUIDforLoanNumber(LoanNumber, accessToken);

                    Loan loan = new Loan();
                    PropertyInfo prop = loan.GetType().GetProperty(fieldName);
                    if (null != prop && prop.CanWrite)
                    {
                        prop.SetValue(loan, newFieldValue, null);
                    }
                    else
                    {
                        throw new Exception("Error finding property " + fieldName + " for loan " + LoanNumber);
                    }

                    string methodURL = EncRESTServiceBaseURL() + "loans/" + loanGUID;

                    string requestString = JsonConvert.SerializeObject(loan);

                    //get lock for loan
                    lockId = getLoanLock(loanGUID, accessToken, LoanNumber);

                    //perform update
                    string responseString = makeServiceRequest(methodURL, WebRequestMethod.PATCH, requestString, accessToken);

                    //release lock for loan
                    releaseLoanLock(loanGUID, lockId, accessToken, LoanNumber);

                    retVal = true;

                    Log.Info("Field " + fieldName + " updated for " + LoanNumber);

                }

            }
            catch (Exception ex)
            {

                Log.Error("Error updating field " + fieldName + " for " + LoanNumber, ex);

                //release lock for loan
                releaseLoanLock(loanGUID, lockId, accessToken, LoanNumber);

                throw ex;
            }

            return retVal;

        }

    }
}
