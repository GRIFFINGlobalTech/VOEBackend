        public string getGUIDforLoanNumber(string LoanNumber, string accessToken)
        {
            string retVal = String.Empty;

            try
            {
                string methodURL = EncRESTServiceBaseURL() + "loanPipeline";

                Pipeline.PipelineRequest request = new Pipeline.PipelineRequest();

                Pipeline.PipelineRequest.filterCriteria.term theTerm = new Pipeline.PipelineRequest.filterCriteria.term("Loan.LoanNumber", 
                    LoanNumber, 
                    FHMC.EncompassREST.Pipeline.PipelineRequest.filterCriteria.term.MatchType.exact);

                Pipeline.PipelineRequest.filterCriteria criteria = new Pipeline.PipelineRequest.filterCriteria();
                criteria.terms.Add(theTerm);
                criteria.@operator = FHMC.EncompassREST.Pipeline.PipelineRequest.filterCriteria.FilterOperator.And;

                request.filter = criteria;

                string requestString = JsonConvert.SerializeObject(request, Newtonsoft.Json.Formatting.None,
                        new JsonSerializerSettings
                        {
                            NullValueHandling = NullValueHandling.Ignore
                        });

                string responseString = makeServiceRequest(methodURL, WebRequestMethod.POST, requestString, accessToken);

                Pipeline.PipelineResponse response = JsonConvert.DeserializeObject<List<Pipeline.PipelineResponse>>(responseString).FirstOrDefault();
                
                if (response == null)
                {

                    //try adding include archived flag
                    request.includeArchivedLoans = "true";

                    requestString = JsonConvert.SerializeObject(request, Newtonsoft.Json.Formatting.None,
                        new JsonSerializerSettings
                        {
                            NullValueHandling = NullValueHandling.Ignore
                        });

                    responseString = makeServiceRequest(methodURL, WebRequestMethod.POST, requestString, accessToken);

                    response = JsonConvert.DeserializeObject<List<Pipeline.PipelineResponse>>(responseString).FirstOrDefault();

                    if (response == null)
                    {
                        //ok it really is an error
                        throw new EncompassREST.CustomException.CustomEMUserLoanPermissionException();
                    }

                }

                retVal = response.loanGuid;

            }
            catch (Exception ex)
            {
                Log.Error("Error getting GUID for loan " + LoanNumber, ex);
                throw ex;
            }

            return retVal;
        }

        public List<_CustomFields.CustomField> getLoanCustomFields(string loanGUID, string accessToken, string loanNumber)
        {
            List<_CustomFields.CustomField> retVal = new List<_CustomFields.CustomField>() { };

            try
            {
                
                string methodURL = EncRESTServiceBaseURL() + "loans/" + loanGUID;

                Dictionary<string, string> urlparams = new Dictionary<string, string>() { };

                urlparams.Add("entities", "CustomField");
                //urlparams.Add("entities", "Loan,LoanAssociate");

                string responseString = makeServiceRequest(methodURL, WebRequestMethod.GET, null, accessToken, urlparams);

                _CustomFields customFields = JsonConvert.DeserializeObject<_CustomFields>(responseString);

                //eventually deserialize to object
                retVal = customFields.customFields;

            }
            catch (Exception ex)
            {
                Log.Error("Error getting custom fields for " + loanNumber, ex);
                throw ex;
            }

            return retVal;
        }

        protected string getCustomFieldId(string loanGUID, string customFieldName, string accessToken, string loanNumber)
        {

            string retVal = String.Empty;

            try
            {

                List<_CustomFields.CustomField> customFields = getLoanCustomFields(loanGUID, accessToken, loanNumber);
                //string dfjkh = JsonConvert.SerializeObject(customFields); 

                if (customFields.Exists(q => q.fieldName == customFieldName))
                {
                    retVal = customFields.Find(q => q.fieldName == customFieldName).id;
                }
                //else
                //{
                //    throw new Exception("Custom Field Not Found");
                //}


            }
            catch (Exception ex)
            {
                Log.Error("Error getting custom field id for " + customFieldName, ex);
                //throw ex;
            }

            
            return retVal;

        }

        public bool updateCustomField(string LoanNumber, string customFieldName, string newFieldValue, bool IsAppend, string accessToken)
        {
            bool retVal = false;
            string lockId = null;
            string loanGUID = null;

            try
            {
                //must see if there are still docs in teh loan folder queue that could be importing
                string[] loanDocuments = Directory.GetFiles(LoanFolderImportLocation, LoanNumber + "*");

                if (loanDocuments.Length != 0) { 
                    //there are documents waiting to upload...so we should not try to updateloan until that is complete
                    Log.Info("Documents Waiting to Upload for " + LoanNumber + ". Loan Update Skipped.");

                } else {

                    //first, get the loan GUID
                    loanGUID = getGUIDforLoanNumber(LoanNumber, accessToken);

                    //then get the custom field Id
                    //string customFieldId = getCustomFieldId(loanGUID, customFieldName, accessToken, LoanNumber);
                    
                    //try letting it use field name all the time 10/20/2017
                    //if (customFieldId != String.Empty)
                    //{
                    //    //this field already exists
                    //    customFields.customFields.Add(new _CustomFields.CustomField()
                    //    {
                    //        id = customFieldId,
                    //        stringValue = newFieldValue
                    //    });
                    //} else {
                    //this field does not exist, add it

                    if (IsAppend)
                    {
                        //need to get current value of field in order to append
                        //Appending is only relevant for strings
                        try
                        {
                            List<_CustomFields.CustomField> currentCustomFieldList = getLoanCustomFields(loanGUID, accessToken, LoanNumber);
                            string curValue = currentCustomFieldList.Where<_CustomFields.CustomField>(q => q.fieldName == customFieldName).FirstOrDefault().stringValue;
                            if (curValue != String.Empty)
                            {
                                newFieldValue = curValue + "\n\r" + newFieldValue;
                            }
                        }
                        catch (Exception ex)
                        {
                            Log.Error("Error getting current field value for custom field id" + customFieldName, ex);
                            throw ex;
                        }

                    }

                    _CustomFields customFields = new _CustomFields();

                    customFields.customFields = new List<_CustomFields.CustomField>() { };

                    //DateTime newFieldValueDate;
                    //if (DateTime.TryParse(newFieldValue, out newFieldValueDate))
                    //{
                    //    customFields.customFields.Add(new _CustomFields.CustomField()
                    //    {
                    //        fieldName = customFieldName,
                    //        dateValue = newFieldValueDate
                    //    });
                    //} else {
                        customFields.customFields.Add(new _CustomFields.CustomField()
                        {
                            fieldName = customFieldName,
                            stringValue = newFieldValue
                        });
                    //}

                    string methodURL = EncRESTServiceBaseURL() + "loans/" + loanGUID;

                    string requestString = JsonConvert.SerializeObject(customFields);

                    //get lock for loan
                    lockId = getLoanLock(loanGUID, accessToken, LoanNumber);

                    //perform update
                    string responseString = makeServiceRequest(methodURL, WebRequestMethod.PATCH, requestString, accessToken);

                    //release lock for loan
                    releaseLoanLock(loanGUID, lockId, accessToken, LoanNumber);

                    retVal = true;

                    Log.Info("Custom field " + customFieldName + " updated for " + LoanNumber);

                }

            }
            catch (Exception ex)
            {

                Log.Error("Error updating custom field id " + customFieldName + " for " + LoanNumber, ex);

                //release lock for loan
                releaseLoanLock(loanGUID, lockId, accessToken, LoanNumber);

                throw ex;
            }

            return retVal;

        }

        public bool updateCustomFields(string LoanNumber, Dictionary<string, string> customFieldValues, string accessToken)
        {
            bool retVal = false;
            string lockId = null;
            string loanGUID = null;

            try
            {
                //must see if there are still docs in teh loan folder queue that could be importing
                string[] loanDocuments = Directory.GetFiles(LoanFolderImportLocation, LoanNumber + "*");

                if (loanDocuments.Length != 0)
                {
                    //there are documents waiting to upload...so we should not try to updateloan until that is complete
                    Log.Info("Documents Waiting to Upload for " + LoanNumber + ". Loan Update Skipped.");

                }
                else
                {

                    //first, get the loan GUID
                    loanGUID = getGUIDforLoanNumber(LoanNumber, accessToken);

                    _CustomFields customFields = new _CustomFields();

                    customFields.customFields = new List<_CustomFields.CustomField>() { };

                    foreach (KeyValuePair<string, string> customField in customFieldValues)
                    {
                        customFields.customFields.Add(new _CustomFields.CustomField()
                        {
                            fieldName = customField.Key,
                            stringValue = customField.Value
                        });

                    }

                    string methodURL = EncRESTServiceBaseURL() + "loans/" + loanGUID;

                    string requestString = JsonConvert.SerializeObject(customFields);

                    //get lock for loan
                    lockId = getLoanLock(loanGUID, accessToken, LoanNumber);

                    //perform update
                    string responseString = makeServiceRequest(methodURL, WebRequestMethod.PATCH, requestString, accessToken);

                    //release lock for loan
                    releaseLoanLock(loanGUID, lockId, accessToken, LoanNumber);

                    retVal = true;

                    foreach (KeyValuePair<string, string> customField in customFieldValues)
                    {
                        Log.Info("Custom field " + customField.Key + " updated for " + LoanNumber);

                    }

                }

            }
            catch (Exception ex)
            {

                Log.Error("Error updating custom fields for " + LoanNumber, ex);

                //release lock for loan
                if (loanGUID != null)
                {
                    releaseLoanLock(loanGUID, lockId, accessToken, LoanNumber);
                }

                throw ex;
            }

            return retVal;

        }

        public Dictionary<string, object> queryLoanFieldsByGUID(string GUID, List<string> fieldIds, string accessToken)
        {

            Dictionary<string, object> retVal = new Dictionary<string, object>() { };

            //try
            //{

                //string LoanGUID = getGUIDforLoanNumber(loanNumber, accessToken);

                string methodURL = EncRESTServiceBaseURL() + "loans/" + GUID + "/fieldReader?includeMetadata=true";

                string requestString = JsonConvert.SerializeObject(fieldIds, Newtonsoft.Json.Formatting.None,
                        new JsonSerializerSettings
                        {
                            NullValueHandling = NullValueHandling.Ignore
                        });

                string responseString = makeServiceRequest(methodURL, WebRequestMethod.POST, requestString, accessToken);

                List<FieldValue> fields = JsonConvert.DeserializeObject<List<FieldValue>>(responseString);

                foreach (FieldValue field in fields)
                {
                    if (field.type == "date")   
                    {
                        DateTime dateValue;
                        if (DateTime.TryParse(field.value, out dateValue)) {
                            retVal.Add(field.fieldId, dateValue);
                        }
                    } else {
                        //treat as string.  can add more formats here if nec
                        retVal.Add(field.fieldId, field.value);
                    }
                }

            //}
            //catch (Exception ex)
            //{
            //    Log.Error("Error getting fields for " + GUID, ex);
            //    //throw ex;
            //}


            return retVal;



        }

        public Dictionary<string, object> getLoanFieldsByGUID(string LoanGUID, List<string> fieldIds, string accessToken)
        {

            Dictionary<string, object> retVal = new Dictionary<string, object>() { };

            try
            {

                List<string> regFields = fieldIds.Where(q => !q.Contains("#") && !q.Contains("Loan.") && q != "MS.LOCKDAYS").ToList();
                retVal = queryLoanFieldsByGUID(LoanGUID, regFields, accessToken);

                List<string> pairFields = fieldIds.Where(q => q.Contains("#") || q.Contains("Loan.") || q == "MS.LOCKDAYS").ToList();
                if (pairFields.Count > 0)
                {
                    //use the pipeline query to get these guys.  field reader does not return the proper pair designation
                    Pipeline pOp = new Pipeline();
                    Dictionary<string, string> fieldStringVals = pOp.queryPipelineByGUIDs(pairFields, new List<string> { LoanGUID }, accessToken).FirstOrDefault().Value;
                    Dictionary<string, object> fieldObjValues = fieldStringVals.Select<KeyValuePair<string, string>, KeyValuePair<string, object>>(q => new KeyValuePair<string, object>(q.Key, q.Value))
                        .ToList().ToDictionary(q => q.Key, q => q.Value);
                    //this could be improved but for now...
                    foreach(KeyValuePair<string, object> pair in fieldObjValues)
                    {
                        retVal.Add(pair.Key, pair.Value);
                    }

                }


                //Log.Info(JsonConvert.SerializeObject(retVal));
            } 
            catch (Exception ex)
            {
                Log.Error("Error getting fields for " + LoanGUID, ex);
                //throw ex;
            }


            return retVal;



        }

        public Dictionary<string, object> getLoanFields(string loanNumber, List<string> fieldIds, string accessToken)
        {

            Dictionary<string, object> retVal = new Dictionary<string, object>() { };

            try
            {

                string LoanGUID = getGUIDforLoanNumber(loanNumber, accessToken);

                retVal = getLoanFieldsByGUID(LoanGUID, fieldIds, accessToken);

            }
            catch (Exception ex)
            {
                Log.Error("Error getting fields for " + loanNumber, ex);
                //throw ex;
            }


            return retVal;



        }


