        //V3 API
        public class Attachment
        {
            public string id { get; set; }
            public string attachmentId { get { return id; } } //for v1 compatibility
            public string title { get; set; }
            public string type { get; set; }
            public bool isActive { get; set; }
            public List<string> sources { get; set; }
            public AssociatedEntity assignedTo { get; set; }
            public AssociatedEntity document { get { return assignedTo; } } //for v1 compatibility
            public List<AttachmentPage> pages { get; set; }
            public DateTime createdDate { get; set; }
            public AssociatedEntity createdBy { get; set; }

            public class AttachmentPage
            {
                public PageImage pageImage { get; set; }
                public string originalKey { get; set; }
            }

            public class AssociatedEntity
            {
                
                public string entityId { get; set; }
                public string entityType { get; set; }
                public string entityName { get; set; }
            }

            public class PageImage
            {
               
			    public string zipKey { get; set; }
                public string imageKey { get; set; }
                public string originalKey { get; set; }
            }

        }

