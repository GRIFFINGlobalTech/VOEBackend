        //V3 API
        public class Document
        {
            public string id { get; set; }
            public string documentId { get { return id; } } //for v1 compatibility

            public string title { get; set; }
            public string description { get; set; }
            public string status { get; set; }
            public AssociatedEntity createdBy { get; set; }
            public DateTime createdDate { get; set; }
            public AssociatedEntity milestone { get; set; }
            public List<AssociatedEntity> attachments { get; set; }
            public DateTime? readyToShipDate { get; set; } 

            public class AssociatedEntity
            {
                public bool isActive { get; set; }
                public string entityId { get; set; }
                public string entityType { get; set; }
                public string entityName { get; set; }
                public string entityUri { get; set; }
            }
        }

