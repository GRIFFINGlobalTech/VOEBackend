        public Dictionary<string,string> getReportingFieldsforLoanNumber(string LoanNumber, List<string> rdbFields, string accessToken)
        {
            Dictionary<string, string> retVal = new Dictionary<string, string>() { };

            try
            {
                
                //filter out non-existent fields for this particular loan

                //first, get all custom fields
                //string loanGUID = getGUIDforLoanNumber(LoanNumber, accessToken);
               // List<_CustomFields.CustomField> existingFields = getLoanCustomFields(loanGUID, accessToken, LoanNumber);

                //convert to Dictionary<string,string> format
                //retVal = existingFields.ToDictionary(q => q.fieldName, q => q.stringValue);

                //Log.Info("EncompassREST Field List:");
                //Log.Info(JsonConvert.SerializeObject(retVal));


                //filter on rdbFieldList
                //retVal = retVal.Where(pair => rdbFields.Contains(pair.Key)).ToDictionary(pair => pair.Key, pair => pair.Value);



                //this is the pipeine query method - it errors out if you request a field that does not exist
                string methodURL = EncRESTServiceBaseURL + "loanPipeline";

                Pipeline.PipelineRequest request = new Pipeline.PipelineRequest();

                Pipeline.PipelineRequest.filterCriteria.term theTerm = new Pipeline.PipelineRequest.filterCriteria.term("Loan.LoanNumber", 
                    LoanNumber,
                    FHMC.EncompassREST.Pipeline.PipelineRequest.filterCriteria.term.MatchType.exact);

                Pipeline.PipelineRequest.filterCriteria criteria = new Pipeline.PipelineRequest.filterCriteria();
                criteria.terms.Add(theTerm);
                criteria.@operator = FHMC.EncompassREST.Pipeline.PipelineRequest.filterCriteria.FilterOperator.And;

                request.filter = criteria;

                //add "Fields." to each of the field ids
                request.fields = rdbFields.Select<string, string>(q => {
                    if (!q.ToString().StartsWith("Loan.")) {
                        q = "Fields." + q.ToString();
                    }
                    return q;
                }).ToList();

                bool validFieldList = false;
                string responseString = String.Empty;

                //try request, remove fields reported not to exist
                while (!validFieldList) { 
                    try
                    {
                        string requestString = JsonConvert.SerializeObject(request, Newtonsoft.Json.Formatting.None, 
                            new JsonSerializerSettings { 
                                NullValueHandling = NullValueHandling.Ignore
                            });

                        responseString = makeServiceRequest(methodURL, WebRequestMethod.POST, requestString, accessToken);

                        //hey we finally got a vaild responsse
                        validFieldList = true;
                    }
                    catch (Exception ex)
                    {
                        if (ex.Message.ToLower().Contains("invalid canonical name"))
                        {
                            int iFieldListStart = ex.Message.IndexOf("Fields.");
                            List<string> invalidFields = ex.Message.Substring(iFieldListStart).Split(","[0]).ToList();
                            foreach (string field in invalidFields) {
                                request.fields.Remove(field.Trim());
                            }
                            //try again
                            if (request.fields.Count == 0)
                            {
                                throw new Exception("Field List Emptied");
                            }
                            Log.Info("Retrying Field List for " + LoanNumber);
                        }
                        else
                        {
                            //some other kind of error
                            throw ex;
                        }
                    }
                }


                Pipeline.PipelineResponse response = JsonConvert.DeserializeObject<List<Pipeline.PipelineResponse>>(responseString).FirstOrDefault();

                //remove "Fields." from each of the field ids
                retVal = response.fields.ToDictionary(q => {
                    if (!q.Key.StartsWith("Loan."))
                    {
                        return q.Key.Substring(7);
                    }
                    else
                    {
                        return q.Key;
                    }
                }, q => q.Value);


            }
            catch (Exception ex)
            {
                Log.Error("Error getting ReportingFields for loan " + LoanNumber, ex);
                throw ex;
            }

            return retVal;
        }

        public bool moveLoanFolder(string LoanNumber, string newFolderName, string accessToken)
        {
            bool retVal = false;

            try
            {
                
                //first, get the loan GUID
                string loanGUID = getGUIDforLoanNumber(LoanNumber, accessToken);

                string methodURL = EncRESTServiceBaseURL + "loanfolders/" + newFolderName + "/loans";

                Dictionary<string, string> urlParams = new Dictionary<string, string>() { };
                urlParams.Add("action", "add");

                FolderMoveRequest req = new FolderMoveRequest();
                req.loanGuid = loanGUID;

                string requestString = JsonConvert.SerializeObject(req);

                string responseString = makeServiceRequest(methodURL, WebRequestMethod.PATCH, requestString, accessToken, urlParams);

                retVal = true;

                Log.Info("Loan Folder updated for " + LoanNumber);

                

            }
            catch (Exception ex)
            {
                Log.Error("Error moving to loan folder for loan " + LoanNumber, ex);
                throw ex;
            }

            return retVal;

        }

        public bool deleteLoan(string LoanNumber, string accessToken)
        {
            bool retVal = false;

            try
            {

                //first, get the loan GUID
                string loanGUID = getGUIDforLoanNumber(LoanNumber, accessToken);

                string methodURL = EncRESTServiceBaseURL + "loans/" + loanGUID;

                string responseString = makeServiceRequest(methodURL, WebRequestMethod.DELETE, null, accessToken, null);

                retVal = true;

                Log.Info("Loan deleted: " + LoanNumber);



            }
            catch (Exception ex)
            {
                Log.Error("Error deleting loan " + LoanNumber, ex);
                throw ex;
            }

            return retVal;

        }

