        private string EncClientID;
        private string EncClientSecretKey;

        public Authentication() : base() { setCredentials(); }
        public Authentication(object Log) : base(Log) { setCredentials(); }
        
        private void setCredentials()
        {

            System.Configuration.AppSettingsReader appSettings = new AppSettingsReader();
